---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectsExplorer from "@/components/ProjectsExplorer.astro";
import { byOrder } from "@/lib/content";

const projects = (await getCollection("projects")).sort(byOrder);
---

<BaseLayout
  title="Dwarak Foundations"
  description="Dwarak Chakravarthy Nagar in Pallikaranai starts from ₹7,400 per sq.ft. See completed and ongoing Dwarak Foundations projects across Chennai."
>
  <header class="page-hero page-hero--projects page-hero--offer">
    <div class="page-hero__grid shell">
      <div>
        <p class="eyebrow">Now selling</p>
        <h1 class="page-title">Dwarak Chakravarthy Nagar</h1>
        <p class="lede">A gated community on 5th Cross Street, Pallikaranai.</p>
        <p class="offer-visit">
          <a class="button button--accent" href="/contact/" data-analytics-event="contact_opened" data-analytics-target="velachery_office">
            Visit us in our office <span aria-hidden="true">↗</span>
          </a>
        </p>
      </div>
      <div class="page-hero__aside offer-price">
        <p class="offer-price__label">Starts from</p>
        <p class="offer-price__figure">₹7,400 <small>per sq.ft</small></p>
        <a class="button button--accent" href="/projects/chakravarthy-nagar/" data-analytics-event="project_opened">
          More details <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </header>

  <section class="work-across" aria-labelledby="work-across-title">
    <div class="shell">
      <h2 id="work-across-title" class="page-title">Our work across Chennai.</h2>
    </div>
    <ProjectsExplorer projects={projects} fullBleed />
  </section>
</BaseLayout>
