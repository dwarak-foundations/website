---
import BaseLayout from "@/layouts/BaseLayout.astro";
import WhatsAppIcon from "@/components/WhatsAppIcon.astro";
import { email, whatsappDisplayNumber, whatsappHref } from "@/lib/contact";

const officeQuery = "Plot 13, Gomathi Bhavan, 2nd Cross Street, VGP Selva Nagar, Velachery, Chennai 600042";
const mapEmbed = `https://maps.google.com/maps?q=${encodeURIComponent(officeQuery)}&z=16&hl=en&output=embed`;
const whatsappUrl = whatsappHref("Hello, I would like to know more about Dwarak Foundations.");
---

<BaseLayout
  title="Contact"
  description="Contact Dwarak Foundations in Velachery, Chennai to discuss a new home or residential construction project."
>
  <header class="page-hero">
    <div class="page-hero__grid shell">
      <div>
        <p class="eyebrow">Contact</p>
        <h1 class="page-title">Every project starts with listening.</h1>
      </div>
      <div class="page-hero__aside">
        <p>
          Tell us about your site, your family, and what you hope to create. We will help you understand the next step.
        </p>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="contact-grid shell">
      <div data-reveal>
        <p class="eyebrow">Reach our team</p>
        <div class="contact-list">
          <div class="contact-item">
            <span>WhatsApp</span>
            <div>
              <a class="button button--accent" href={whatsappUrl} target="_blank" rel="noreferrer" data-analytics-event="whatsapp_clicked" data-analytics-target="contact_primary">
                <span class="button__label"><WhatsAppIcon />Contact us</span>
                <span>{whatsappDisplayNumber} <span aria-hidden="true">↗</span></span>
              </a>
            </div>
          </div>
          <div class="contact-item">
            <span>Email</span>
            <div>
              <a href={`mailto:${email}`} data-analytics-event="email_clicked" data-analytics-target="contact">
                {email}
              </a>
            </div>
          </div>
          <div class="contact-item">
            <span>Visit</span>
            <address>
              Plot 13, Door 7, Flat T1<br />
              Gomathi Bhavan<br />
              2nd Cross Street<br />
              VGP Selva Nagar<br />
              Velachery, Chennai 600042
            </address>
          </div>
          <div class="contact-item">
            <span>Hours</span>
            <div>Monday to Saturday<br />9:30 am to 6:00 pm</div>
          </div>
        </div>
      </div>
      <div class="map-frame contact-aside" data-reveal>
        <iframe
          src={mapEmbed}
          title="Map showing the Dwarak Foundations office in Velachery"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
