          {print && <p class="brochure-phone"><a href={waEn}>{phone}</a></p>}
        </div>
        <div class="brochure-ask-panel__actions">
          <a class="button button--accent locale-en" href={waEn} target="_blank" rel="noreferrer" data-analytics-event="whatsapp_clicked" data-analytics-target="chakravarthy_nagar_price">
