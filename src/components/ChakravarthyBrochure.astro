<script>
  const root = document.querySelector<HTMLElement>("[data-brochure='web']");
  if (root) {
    const toggle = root.querySelector<HTMLButtonElement>("[data-spec-toggle]");
    const closedLabel = toggle?.querySelector<HTMLElement>("[data-when-closed]");
    const openLabel = toggle?.querySelector<HTMLElement>("[data-when-open]");
    toggle?.addEventListener("click", () => {
      const specs = [...root.querySelectorAll<HTMLDetailsElement>("[data-spec]")];
      const expand = specs.some((item) => !item.open);
      for (const item of specs) item.open = expand;
      toggle.setAttribute("aria-expanded", String(expand));
      if (closedLabel) closedLabel.hidden = expand;
      if (openLabel) openLabel.hidden = !expand;
    });

    const links = [...root.querySelectorAll<HTMLAnchorElement>("[data-nav]")];
    const linkFor = new Map(links.flatMap((link) => {
      const id = link.getAttribute("href")?.slice(1);
      const section = id ? document.getElementById(id) : null;
      return section ? [[section, link] as const] : [];
    }));
    if (linkFor.size > 0) {
      const spy = new IntersectionObserver((entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible) return;
        for (const link of links) {
          const current = link === linkFor.get(visible.target as HTMLElement);
          if (current) link.setAttribute("aria-current", "true");
          else link.removeAttribute("aria-current");
        }
      }, { rootMargin: "-30% 0px -55% 0px", threshold: [0.1, 0.25, 0.5] });
      for (const section of linkFor.keys()) spy.observe(section);
    }

    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-place-tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-place-panel]")];
    const showPlaces = (id: string) => {
      for (const tab of tabs) {
        const on = tab.dataset.placeTab === id;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
      }
      for (const panel of panels) panel.hidden = panel.dataset.placePanel !== id;
    };
    for (const tab of tabs) {
      tab.addEventListener("click", () => showPlaces(tab.dataset.placeTab ?? ""));
    }
  }
</script>
