      <div class="brochure-limits">
        <h3><LocaleText en="So nothing is assumed" ta="எதுவும் யூகிக்கப்படாமல்" /></h3>
        <ul>
          {limits.map((limit) => (
            <li>
              <strong><LocaleText en={limit.title.en} ta={limit.title.ta} /></strong>
              <span><LocaleText en={limit.text.en} ta={limit.text.ta} /></span>
